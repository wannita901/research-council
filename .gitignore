__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env
runs/
.pytest_cache/
.DS_Store
*.pdf
mise.local.toml

# Playwright MCP scratch artifacts
.playwright-mcp/

# Wiki library archives (local snapshots)
knowledge/.archive/

# LLM-wiki generated corpus (keep CLAUDE.md; ignore generated pages/papers + the auto-
# regenerated index/log, which every harvest rewrites — harvest is on by default for live runs)
knowledge/wiki/*/
knowledge/wiki/index.md
knowledge/wiki/log.md
knowledge/raw/external/*
!knowledge/raw/external/.gitkeep

# Downloaded skills/agents — belong in the plugin/user dirs, not this repo
.agents/
.claude/
skills-lock.json

# Per-project lifecycle state + traces
projects/

# Committed verifiability test fixtures (sanitized stand-ins for the live projects/*).
# Re-include the fake paper.pdf the pdf-check fixture needs, which *.pdf above would ignore.
!tests/fixtures/verify/**/*.pdf
